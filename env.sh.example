#!/usr/bin/env bash
#
# Sample environment for go-rflink.
# Copy and edit; most defaults are fine — only set what you need.
#
#   set -a && source ./env.sh && set +a && ./go-rflink
#

# --- Logging ---
# export LOG_LEVEL=info                    # debug | info | warn | error
# export GORFLINK_DEBUG=false              # true forces debug level

# --- MQTT broker ---
# export PUBLISH_HOST=localhost:1883
# export PUBLISH_SCHEME=tcp                # tcp|mqtt, ssl|tls|mqtts, ws, wss
# export PUBLISH_MQTT_USERNAME=username
# export PUBLISH_MQTT_PASSWORD=password
# export PUBLISH_CLIENT_ID=gorflink
# export PUBLISH_TOPIC=rflink
# export PUBLISH_CMD_TOPIC=                # default: ${PUBLISH_TOPIC}/send
# export PUBLISH_QOS=0
# export PUBLISH_RETAIN=false
# export PUBLISH_CLEAN_SESSION=true
# export PUBLISH_KEEPALIVE=30
# export PUBLISH_SESSION_EXPIRY=0
# export PUBLISH_INFINITY_RECONNECT=true
# export PUBLISH_CONNECT_RETRY_INTERVAL=5

# --- TLS (when PUBLISH_SCHEME is ssl/tls/mqtts/wss) ---
# export PUBLISH_TLS_CA_FILE=/path/to/ca.crt
# export PUBLISH_TLS_INSECURE_SKIP_VERIFY=false

# --- LWT (optional; default uses ${PUBLISH_TOPIC}/status offline) ---
# export PUBLISH_LWT_TOPIC=
# export PUBLISH_LWT_MESSAGE=
# export PUBLISH_LWT_QOS=0
# export PUBLISH_LWT_RETAIN=false

# --- Sensor publish behaviour ---
# export PUBLISH_TEMPERATURE_UNIT=C        # C | F | RAW
# export PUBLISH_DEDUP_WINDOW_MS=3000      # 0 = disable debounce
# export PUBLISH_PENDING_TTL_SEC=60        # 0 = no offline buffer
# export PUBLISH_HEALTH_LOG_INTERVAL_SEC=300
# export PUBLISH_FRIENDLY_NAMES="EV1527_0B25F2:Front Door,LACROSSEV4_0002:Bedroom"
# export PUBLISH_HWID_MAP="2A01:LIVING_TEMP,0b25f2:FRONT_REMOTE"
# export PUBLISH_IGNORE_LIST="Keeloq,NOISE_MODEL,FFFF"

# --- Commands (MQTT → RFLink) ---
# export PUBLISH_COMMAND_WHITELIST="10;,11;"   # empty = allow all
# export PUBLISH_COMMAND_RATE_LIMIT=5
# export PUBLISH_COMMAND_MAX_LEN=256

# --- Home Assistant discovery ---
# export PUBLISH_HOME_ASSISTANT_DISCOVERY=false
# export PUBLISH_HA_DISCOVERY_PREFIX=homeassistant
# Buttons: Label:command  (comma-separated)
# export PUBLISH_HA_BUTTONS="Siren On:10;NewKaku;123456;ON;"
# Switches: Label:on_cmd:off_cmd
# export PUBLISH_HA_SWITCHES="Garden Light:10;NewKaku;AABB;ON;:10;NewKaku;AABB;OFF;"

# --- Serial / RFLink ---
# export SERIAL_DEVICE=/dev/ttyUSB0
# export SERIAL_BAUD=57600
# export SERIAL_READ_TIMEOUT_SEC=10
# export SERIAL_RECONNECT_MIN_DELAY_SEC=3
# export SERIAL_RECONNECT_MAX_DELAY_SEC=60
# export SERIAL_WATCHDOG_SEC=120
# export SERIAL_PING_INTERVAL_SEC=60       # 0 = disable PING; don't do this :D
# export SERIAL_PING_TIMEOUT_SEC=5
# export SERIAL_PING_FAIL_THRESHOLD=3

# --- HTTP API / Web GUI (optional) ---
# export HTTP_LISTEN=127.0.0.1:8080      # prefer loopback; avoid :8080 on all interfaces empty = disabled
# export HTTP_AUTH_TOKEN=change-me-gui   # GUI login only; optional for api calls; required if listen is non-localhost (warned at start) Bearer / X-API-Token
# export HTTP_READ_ONLY=false            # read-only GUI even with auth, shields u from unwanted saving runtime_config file in ENV-only mode or for public exposing(u may, but advised: do not expose)
# export HTTP_GUI=true                   # if u want api but no-gui mode set to false
# export HTTP_RAW_BUFFER_SIZE=100
# export HTTP_SENSOR_BUFFER_SIZE=50

# export HTTP_CORS_ORIGINS=
# export HTTP_TRUSTED_PROXIES=           # if behind cloudflare\npm\traefic\router\etc proxy


# --- Runtime overlay + API tokens ---
# export RUNTIME_CONFIG_FILE=data/runtime.json  # advised not to change in docker
# export API_AUTH_TOKEN=ha:secret1:never:read+command(default),script:secret2:3h:read+command+admin   # machine API tokens only, u cant login GUI with them; mostly needed in ENV-only mode overwise create it in GUI
# export API_TOKEN_PEPPER=optional-hmac-pepper     # really don't needed, but for paranoids

# --- WEBHOOKS ---
# export WEBHOOKS_JSON='[{"name":"poll1","enabled":true,"kind":"poll","url":"https://example.com/cmd","method":"GET","interval_sec":30}]'    # read docs
